{
 "$schema": "https://design-tokens.github.io/community-group/format/",
 "$description": "민주주의의 여정 시멘틱 토큰. shadcn/ui 구조 + 게임 전용 역할(stat·judge·trust·era). 값은 themes 에서 공급. CSS 변수명 = 경로를 '-' 로 이은 것 (color.semantic.stat.join → --stat-join).",
 "meta": {
  "project": "democracy-journey",
  "created": "2026-10-10",
  "stage": "02",
  "chosenTheme": "watercolor",
  "approved": "2026-10-10 1차 게이트 수채 · 2차 게이트 B 무대 아래 카드"
 },
 "size": {
  "tap-min": "48px",
  "stage-w": "1024px",
  "stage-h": "768px",
  "portrait-w": "240px",
  "card-min-h": "112px"
 },
 "spacing": {
  "1": "4px",
  "2": "8px",
  "3": "12px",
  "4": "16px",
  "5": "20px",
  "6": "24px",
  "8": "32px",
  "10": "40px",
  "12": "48px"
 },
 "radius": {
  "sm": "{theme.radius.sm}",
  "md": "{theme.radius.md}",
  "lg": "{theme.radius.lg}",
  "full": "9999px"
 },
 "typography": {
  "font": {
   "display": "{theme.font.display}",
   "body": "{theme.font.body}",
   "hand": "{theme.font.hand}"
  },
  "size": {
   "sm": "16px",
   "base": "20px",
   "lg": "24px",
   "xl": "30px",
   "2xl": "40px",
   "3xl": "56px"
  },
  "lineHeight": {
   "tight": 1.25,
   "normal": 1.55
  },
  "$note": "본문(대사) 최소 20px, 카드 라벨 20px, 보조 라벨만 16px. hand 는 메모·회상 컷 전용, 본문 금지"
 },
 "shadow": {
  "card": "{theme.shadow.card}",
  "press": "{theme.shadow.press}"
 },
 "color": {
  "semantic": {
   "background": "{theme.background}",
   "foreground": "{theme.foreground}",
   "card": "{theme.card}",
   "card-foreground": "{theme.card-foreground}",
   "popover": "{theme.popover}",
   "popover-foreground": "{theme.popover-foreground}",
   "primary": "{theme.primary}",
   "primary-foreground": "{theme.primary-foreground}",
   "secondary": "{theme.secondary}",
   "secondary-foreground": "{theme.secondary-foreground}",
   "muted": "{theme.muted}",
   "muted-foreground": "{theme.muted-foreground}",
   "accent": "{theme.accent}",
   "accent-foreground": "{theme.accent-foreground}",
   "destructive": "{theme.destructive}",
   "destructive-foreground": "{theme.destructive-foreground}",
   "border": "{theme.border}",
   "input": "{theme.input}",
   "ring": "{theme.ring}",
   "page": "{theme.page}",
   "stat": {
    "join": "{theme.stat.join}",
    "info": "{theme.stat.info}",
    "home": "{theme.stat.home}",
    "$note": "참여(손)·정보(돋보기)·살림(집). 색만으로 구분하지 않는다 — 항상 아이콘·라벨 동반"
   },
   "judge": {
    "correct": "{theme.judge.correct}",
    "correct-foreground": "{theme.judge.correct-foreground}",
    "wrong": "{theme.judge.wrong}",
    "wrong-foreground": "{theme.judge.wrong-foreground}",
    "locked": "{theme.judge.locked}",
    "locked-foreground": "{theme.judge.locked-foreground}",
    "$note": "locked = 잠긴 선택지 카드"
   },
   "trust": {
    "low": "{theme.trust.low}",
    "mid": "{theme.trust.mid}",
    "high": "{theme.trust.high}",
    "$note": "판별③ 신뢰도 3단계. 글자 '낮음·중간·높음' 동반"
   }
  }
 },
